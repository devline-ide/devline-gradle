{
  "schemaVersion": 1,
  "apiVersion": 6,
  "compatibility": {
    "minIdeVersion": "0.1.0",
    "capabilities": [
      "ui.webviews",
      "ui.sidebar",
      "project.context"
    ]
  },
  "entryPoint": "devline.gradle.GradleExtension",
  "extension": {
    "schemaVersion": 1,
    "id": "devline.gradle",
    "version": "0.1.2",
    "name": {
      "en": "Gradle",
      "ru": "Gradle"
    },
    "description": {
      "en": "Gradle projects, task discovery and build output.",
      "ru": "Проекты Gradle, задачи и вывод сборки."
    },
    "publisher": "DevLine",
    "icon": "data:image/png;base64,",
    "rpcNamespace": "gradle",
    "enabledByDefault": true,
    "tools": [],
    "commands": []
  },
  "libraries": [
    "lib/devline-gradle-0.1.0.jar",
    "lib/gson-2.13.2.jar",
    "lib/gradle-tooling-api-9.7.1.jar",
    "lib/slf4j-api-2.0.17.jar"
  ],
  "webviews": [
    {
      "id": "projects",
      "title": {
        "en": "Gradle",
        "ru": "Gradle"
      },
      "html": "web/gradle.html",
      "methods": [
        "overview",
        "connect",
        "disconnect",
        "sync",
        "run",
        "stop",
        "state"
      ],
      "location": "sidebar",
      "icon": "tools"
    }
  ]
}
